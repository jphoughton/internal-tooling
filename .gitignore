# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environment
venv/
.venv/
env/

# Environment variables (secrets)
.env

# Database files (contain live data)
*.db
*.db-shm
*.db-wal
data/*
!data/seed.sql.gz

# IDE (keep .vscode/settings.json and extensions.json tracked)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Claude Code (allow shared settings, ignore local overrides)
.claude/*
!.claude/settings.json
.claude/settings.local.json

# Node (husky, commitlint, lint-staged)
node_modules/

# Misc
*.log
*.setup_done
.setup_done
excel_contents.txt
.env.local
.env*.local

# Gorgias exports (contains customer PII — never commit)
scripts/gorgias_out/
