# ============================================
# Inventory Demand Forecasting System
# Copy this file to .env and fill in your values
# ============================================

# --- MCP Servers (for Claude Code) ---
# GitHub: https://github.com/settings/tokens -> repo, read:org scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Mode ---
# Set to "false" when you have API credentials ready
USE_MOCK_DATA=true

# --- Amazon SP-API ---
AMAZON_REFRESH_TOKEN=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_ROLE_ARN=

# --- Shopify Admin API (OAuth via Dev Dashboard) ---
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01

# --- Forecasting ---
FORECAST_HORIZON_DAYS=365
MIN_HISTORY_DAYS=60
LEAD_TIME_DAYS=14
SAFETY_STOCK_MULTIPLIER=1.5

# --- Scheduler ---
SYNC_HOUR=6
SYNC_MINUTE=0
